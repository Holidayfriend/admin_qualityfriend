generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String    @id @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("super_admins")
}

enum HotelLanguage {
  EN
  DE
  IT
}

enum UserRole {
  EMPLOYEE
  TEAM_LEAD
  MANAGEMENT
  ADMIN
}

enum PaymentProvider {
  PAYPAL
}

enum SubscriptionStatus {
  PENDING
  APPROVAL_PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model BillingConfiguration {
  id           String          @id @db.VarChar(32)
  provider     PaymentProvider @default(PAYPAL)
  environment  String          @default("sandbox") @db.VarChar(16)
  productId    String?         @map("product_id") @db.VarChar(128)
  planId       String?         @map("plan_id") @db.VarChar(128)
  productName  String          @map("product_name") @db.VarChar(127)
  planName     String          @map("plan_name") @db.VarChar(127)
  currencyCode String          @map("currency_code") @db.VarChar(3)
  monthlyPrice Decimal         @map("monthly_price") @db.Decimal(10, 2)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("billing_configurations")
}

model HotelTenant {
  id               String        @id @db.Uuid
  hotelNameEn      String        @map("hotel_name_en")
  hotelNameDe      String        @map("hotel_name_de")
  hotelNameIt      String        @map("hotel_name_it")
  email            String
  logoUrl          String?       @map("logo_url")
  hotelLanguage    HotelLanguage @map("hotel_language")
  isActive         Boolean       @map("is_active")
  companyName      String        @map("company_name")
  streetAddress    String        @map("street_address")
  postalCode       String        @map("postal_code")
  city             String
  country          String
  contactPerson    String        @map("contact_person")
  phoneNumber      String?       @map("phone_number")
  vatId            String?       @map("vat_id")
  tripadvisorId    String?       @map("tripadvisor_id")
  subscriptionStatus SubscriptionStatus @map("subscription_status")
  paypalSubscriptionId String?   @map("paypal_subscription_id")
  paypalPlanId     String?       @map("paypal_plan_id")
  subscriptionStartedAt DateTime? @map("subscription_started_at")
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")
  subscriptionCancelledAt DateTime? @map("subscription_cancelled_at")
  createdAt        DateTime      @map("created_at")
  users            User[]
  paymentEvents    PaymentEvent[]

  @@map("hotel_tenants")
}

model PaymentEvent {
  id                    String          @id @db.Uuid
  provider              PaymentProvider
  providerEventId       String          @unique @map("provider_event_id")
  eventType             String          @map("event_type")
  providerTransactionId String?         @map("provider_transaction_id")
  amount                Decimal?        @db.Decimal(12, 2)
  currencyCode          String?         @map("currency_code")
  transactionAt         DateTime?       @map("transaction_at")
  hotelTenantId         String?         @map("hotel_tenant_id") @db.Uuid
  payload               Json
  processedAt           DateTime?       @map("processed_at")
  createdAt             DateTime        @map("created_at")
  hotelTenant           HotelTenant?    @relation(fields: [hotelTenantId], references: [id])

  @@map("payment_events")
}

model User {
  id            String        @id @db.Uuid
  hotelTenantId String        @map("hotel_tenant_id") @db.Uuid
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  email         String        @unique
  passwordHash  String        @map("password_hash")
  phoneNumber   String?       @map("phone_number")
  language      HotelLanguage
  role          UserRole
  isActive      Boolean       @map("is_active")
  isDeleted     Boolean       @map("is_deleted")
  lastLoginAt   DateTime?     @map("last_login_at")
  hotelTenant   HotelTenant   @relation(fields: [hotelTenantId], references: [id])

  @@map("users")
}
